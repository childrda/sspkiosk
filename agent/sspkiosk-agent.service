[Unit]
Description=SSP Kiosk heartbeat agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sspkiosk
Group=sspkiosk
ExecStart=/usr/local/bin/sspkiosk-agent run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/sspkiosk

[Install]
WantedBy=multi-user.target
